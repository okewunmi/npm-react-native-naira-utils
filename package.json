{
  "name": "react-native-naira-utils",
  "version": "0.4.0",
  "description": "Pure JS/TypeScript utilities for Nigerian React Native apps: Naira/kobo formatting and exact money math, phone/network detection, USSD helpers, NUBAN validation and bank guessing, payment-fee and gross-up calculators, VAT/PAYE estimators, amount-in-words, masking and live amount-input formatting. Works with Expo (no native modules required).",
  "keywords": [
    "amount-in-words",
    "bank-validation",
    "expo",
    "fintech",
    "flutterwave",
    "gross-up",
    "kobo",
    "naira",
    "nigeria",
    "nuban",
    "paye",
    "paystack",
    "phone-validation",
    "react-native",
    "stamp-duty",
    "ussd",
    "vat",
    "wht",
    "withholding-tax"
  ],
  "author": "okewunmi-Abdulafeez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okewunmi/npm-react-native-naira-utils.git"
  },
  "homepage": "https://github.com/okewunmi/npm-react-native-naira-utils#readme",
  "bugs": {
    "url": "https://github.com/okewunmi/npm-react-native-naira-utils/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run build && npm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:coverage": "jest --coverage"
  },
  "peerDependencies": {
    "react-native": ">=0.64.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
